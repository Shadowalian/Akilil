# =====================================================================
#  Akilil Platform â€” Environment Configuration
#  Copy this file to `.env` and fill in values before `php artisan key:generate`.
#
#  Sections:
#    1.  Application
#    2.  Database
#    3.  Cache / Queue / Session
#    4.  Mail
#    5.  Filesystem / Object Storage
#    6.  Broadcasting (Laravel Reverb)
#    7.  API / Sanctum (Flutter mobile clients)
#    8.  WebRTC / Video  (Jitsi)
#    9.  Push Notifications (FCM / APNs)
#   10.  Payments â€” Stripe
#   11.  Payments â€” Apple Pay
#   12.  Payments â€” Google Pay
#   13.  Payments â€” Chapa (Ethiopia)
#   14.  Payments â€” Telebirr (Ethiopia)
#   15.  Crisis Detection / Content Moderation
#   16.  Logging
# =====================================================================


# ---- 1. Application --------------------------------------------------
APP_NAME="Akilil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12


# ---- 2. Database (MySQL 8 via XAMPP for local dev) -------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=friend
DB_USERNAME=root
DB_PASSWORD=

# SQLite fallback for quick sandbox runs â€” uncomment to swap.
# DB_CONNECTION=sqlite


# ---- 3. Cache / Queue / Session --------------------------------------
# Dev: database driver is fine. Production: swap to redis (Task 11).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Redis (used in production â€” Task 11)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# ---- 4. Mail ---------------------------------------------------------
# Dev: log driver writes emails to laravel.log. Production: smtp.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@akilil.app"
MAIL_FROM_NAME="${APP_NAME}"

# Production SMTP example (uncomment + fill when moving to prod)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=tls


# ---- 5. Filesystem / Object Storage ----------------------------------
# Dev uses local disk; production uploads (professional documents, journal
# attachments, profile photos) should use S3-compatible storage. Task 11.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Documents disk (private, not publicly served).
# In prod this MUST be an S3 bucket â€” never `public` for credential docs.
PRIVATE_DISK=local


# ---- 6. Broadcasting (Laravel Reverb) -------------------------------
# `php artisan reverb:start` runs the WebSocket server.
REVERB_APP_ID=friend-app
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"


# ---- 7. API / Sanctum (Flutter mobile clients) ----------------------
# Domain(s) allowed to authenticate via session-based SPA mode (admin).
# For pure mobile/API auth this doesn't matter, but the key is required.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1
SANCTUM_TOKEN_LIFETIME_MINUTES=10080  # 7 days for mobile tokens


# ---- 8. WebRTC / Video (Jitsi) --------------------------------------
# Local stack: ../jitsi (docker compose) on http://127.0.0.1:18080
# Copy JWT secrets from ../jitsi/akilil-secrets.env (or jitsi/.env).
JITSI_DOMAIN=127.0.0.1
JITSI_BASE_URL=http://127.0.0.1:18080
JITSI_USE_JWT=true
JITSI_JWT_APP_ID=akilil
JITSI_JWT_SECRET=change-me-to-match-jitsi-JWT_APP_SECRET
JITSI_JWT_AUDIENCE=jitsi
JITSI_JWT_SUBJECT=*
JITSI_WEBHOOK_SECRET=change-me
JITSI_ROOM_PREFIX=akilil-
JITSI_ALLOWED_IFRAME_ORIGINS=*


# ---- 9. Push Notifications (FCM / APNs) -----------------------------
# Used by the broadcast/database/push notification channels (Task 4)
# Flutter apps register their device tokens via POST /api/device-tokens.
FCM_PROJECT_ID=
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_JSON_PATH=

# Apple Push Notification service (iOS)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.friend.user
APNS_PRO_KEY_PATH=                # path to .p8 file
APNS_PRO_KEY_ID=
APNS_ENVIRONMENT=sandbox          # sandbox | production


# ---- 10. Payments â€” Stripe (international, subscriptions, web) ------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=          # for professional payouts (Connect)


# ---- 11. Payments â€” Apple Pay (iOS) ---------------------------------
# Requires Apple Developer portal setup â€” see Task 9 runbook.
APPLE_PAY_MERCHANT_ID=merchant.app.friend
APPLE_PAY_CERT_PATH=
APPLE_PAY_CERT_PASSWORD=
APPLE_PAY_PROCESSOR=stripe          # or your gateway's processor config
APPLE_PAY_ENVIRONMENT=sandbox


# ---- 12. Payments â€” Google Pay (Android) ----------------------------
GOOGLE_PAY_ENVIRONMENT=TEST
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_GATEWAY=stripe
GOOGLE_PAY_GATEWAY_MERCHANT_ID=


# ---- 13. Payments â€” Chapa (Ethiopia, cards & mobile money) ---------
# https://developer.chapa.co/
CHAPA_ENV=sandbox
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_CALLBACK_URL="${APP_URL}/api/webhooks/chapa"
CHAPA_RETURN_URL="${APP_URL}/payments/return"


# ---- 14. Payments â€” Telebirr (Ethiopia mobile money) ----------------
# Telebirr uses an appID / appKey / merchantID triple. Webhook URL is
# configured from Telebirr merchant portal pointing at the URL below.
TELEBIRR_ENV=sandbox
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_MERCHANT_ID=
TELEBIRR_PRIVATE_KEY_PATH=          # RSA private key for signing
TELEBIRR_PUBLIC_KEY_PATH=           # Telebirr's public key for verification
TELEBIRR_WEBHOOK_SECRET=
TELEBIRR_CALLBACK_URL="${APP_URL}/api/webhooks/telebirr"
TELEBIRR_RETURN_URL="${APP_URL}/payments/return"


# ---- 15. Crisis Detection / Content Moderation ----------------------
# v1 is a keyword + sentiment heuristic in code (Task 5).
# Set this to "external" once a real API is wired (Task 5 documents the
# options â€” Perspective API, OpenAI moderation, etc.).
CRISIS_DETECTION_PROVIDER=heuristic
CRISIS_DETECTION_API_KEY=
CRISIS_DETECTION_THRESHOLD=0.7

# Admin alert recipients for crisis_flags (comma-separated emails)
CRISIS_ALERT_EMAILS=safety@akilil.app


# ---- 16. Logging ----------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# ---- Vite (admin panel asset build) ---------------------------------
VITE_APP_NAME="${APP_NAME}"


# ---- Akilil product rules (config/akilil.php) ----
# Demo shortcuts (instant pro approval, free test calls). Never true in production.
AKILIL_DEMO_MODE=false
AKILIL_CURRENCY=ETB
AKILIL_FEE_SESSION_PERCENT=20
AKILIL_FEE_GROUP_PERCENT=20
AKILIL_FEE_GIFT_PERCENT=30
AKILIL_COOKING_MIN_LEAD_HOURS=24
FRONTEND_URL=
